# Source-only repository: opt in project files, keep local game data and tools out.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/requirements-dev.txt
!/native/

/native/*
!/native/CMakeLists.txt
!/native/CMakePresets.json
!/native/magnacarta2_manifest.toml
!/native/config/
!/native/generated/
!/native/patches/
!/native/src/
!/native/tests/
!/native/docs/
!/native/cmake/

# This is SDK build glue, not recompiled game code.
/native/generated/*
!/native/generated/rexglue.cmake

/tools/

# Never stage local builds, game files, captures, or credentials in source folders.
__pycache__/
*.py[cod]
build/
out/
.vs/
.venv/
.env
.env.*
CMakeUserPresets.json
*.exe
*.dll
*.lib
*.obj
*.o
*.a
*.so
*.dylib
*.pdb
*.ilk
*.bin
*.container
*.dxil
*.spv
*.iso
*.xex
*.xbe
*.xxx
*.bik
*.bk2
*.xma
*.xwb
*.xsb
*.dds
*.zip
*.7z
*.rar
*.log
*.dmp
*.rdc
*.etl
*.tracy
*.png
*.jpg
*.mp4
