@@ -0,0 +1,46 @@
+// MC2 diagnostic patch: record guest submissions, not GPU completions or presents.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <fstream>
+#include <iomanip>
+#include <ostream>
+
+namespace rex::graphics {
+// Caller serializes access. The first submission establishes the clock origin.
+// No per-frame allocation or flush; bounded captures stop without affecting GPU work.
+class GuestFrameCsv {
+ public:
+  using Clock = std::chrono::steady_clock;
+  explicit GuestFrameCsv(std::ostream& output, uint64_t limit = 36000)
+      : output_(output), limit_(limit) {
+    output_ << "frame_index,elapsed_seconds,guest_frame_ms\n";
+  }
+
+  void Record(Clock::time_point now) {
+    if (count_ >= limit_ || !output_) return;
+    if (!started_) {
+      started_ = true;
+      start_ = previous_ = now;
+      return;
+    }
+    // steady_clock cannot regress in production; reject bad injected samples.
+    if (now <= previous_) return;
+    const double interval = std::chrono::duration<double, std::milli>(now - previous_).count();
+    const double elapsed = std::chrono::duration<double>(now - start_).count();
+    previous_ = now;
+    output_ << ++count_ << ',' << std::fixed << std::setprecision(9) << elapsed
+            << ',' << std::setprecision(6) << interval << '\n';
+    if (count_ % 120 == 0 || count_ == limit_) output_.flush();
+  }
+
+  uint64_t count() const { return count_; }
+
+ private:
+  std::ostream& output_;
+  uint64_t limit_, count_ = 0;
+  bool started_ = false;
+  Clock::time_point start_{}, previous_{};
+};
+}  // namespace rex::graphics
