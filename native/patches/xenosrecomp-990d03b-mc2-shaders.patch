diff --git a/XenosRecomp/shader_recompiler_check.cpp b/XenosRecomp/shader_recompiler_check.cpp
new file mode 100644
index 0000000..d0f3e97
--- /dev/null
+++ b/XenosRecomp/shader_recompiler_check.cpp
@@ -0,0 +1,123 @@
+// Synthetic fixtures only. No game shaders or generated game code.
+#include "shader_recompiler.h"
+#include <array>
+#include <cstring>
+#include <stdexcept>
+
+static void require(bool condition, const char* message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+static uint32_t swizzle(uint32_t x, uint32_t y, uint32_t z, uint32_t w)
+{
+    return x | (y << 3) | (z << 6) | (w << 9);
+}
+
+static void checkFetches()
+{
+    VertexFetchInstruction vertex{};
+    vertex.dstRegister = 5;
+    vertex.dstSwizzle = swizzle(7, 7, 7, 7);
+    ShaderRecompiler masked;
+    masked.recompile(vertex, 9);
+    require(masked.out.empty(), "Masked vertex fetch wrote a register");
+
+    vertex.dstSwizzle = swizzle(4, 5, 7, 7);
+    vertex.isPredicated = 1;
+    ShaderRecompiler constants;
+    constants.recompile(vertex, 9);
+    require(constants.out == "if (!p0)\n{\n\tr5.x = 0.0;\n\tr5.y = 1.0;\n}\n",
+        "Predicated constant writes changed");
+
+    vertex.isPredicated = 0;
+    vertex.dstSwizzle = swizzle(1, 4, 7, 5);
+    ShaderRecompiler mixed;
+    VertexElement element{};
+    element.usage = DeclUsage::Position;
+    mixed.vertexElements.emplace(9, element);
+    mixed.recompile(vertex, 9);
+    require(mixed.out == "r5.x = iPosition0.y;\nr5.y = 0.0;\nr5.w = 1.0;\n",
+        "Mixed source, constant, and keep components changed");
+
+    TextureFetchInstruction texture{};
+    texture.opcode = FetchOpcode::TextureFetch;
+    texture.dimension = TextureDimension::Texture2D;
+    texture.dstRegister = 5;
+    texture.dstSwizzle = swizzle(7, 7, 7, 7);
+    ShaderRecompiler textureMasked;
+    textureMasked.recompile(texture, false);
+    require(textureMasked.out.empty(), "Masked texture fetch wrote a register");
+    texture.dstSwizzle = swizzle(4, 5, 7, 7);
+    ShaderRecompiler textureConstants;
+    textureConstants.recompile(texture, false);
+    require(textureConstants.out == "r5.x = 0.0;\nr5.y = 1.0;\n",
+        "Texture constant writes changed");
+}
+
+static void checkSamplers(uint16_t count, uint16_t first = 3)
+{
+    // A minimal container with one sampler reflection entry and no instructions.
+    std::array<uint8_t, 268> data{};
+    auto put32 = [&](size_t offset, uint32_t value) {
+        for (size_t i = 0; i < 4; i++)
+            data[offset + i] = uint8_t(value >> (24 - 8 * i));
+    };
+    put32(0, 0x102A1100);
+    put32(4, 256);
+    put32(8, 12);
+    put32(16, 36);
+    put32(24, 200);
+    put32(36, 60);
+    put32(40, 28);
+    put32(52, 1); // Constant count.
+    put32(56, 28); // Entry offset relative to constant table at 40.
+    put32(68, 48); // Name offset relative to the same table.
+    put32(72, (uint32_t(RegisterSet::Sampler) << 16) | first);
+    put32(76, uint32_t(count) << 16);
+    std::memcpy(data.data() + 88, "Array", 6);
+    put32(228, PIXEL_SHADER_OUTPUT_COLOR0);
+    ShaderRecompiler recompiler;
+    recompiler.recompile(data.data(), "");
+    require(recompiler.samplers.size() == count, "Sampler reflection range lost");
+    for (uint32_t i = 0; i < count; i++)
+    {
+        const uint32_t index = first + i;
+        const auto name = count > 1 ? fmt::format("Array_{}", i) : "Array";
+        require(recompiler.samplers.at(index) == name, "Sampler register mapped to wrong name");
+        const auto vulkan = fmt::format("#define {}_Texture2DDescriptorIndex vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + {})", name, index * 4);
+        require(recompiler.out.find(vulkan) != std::string::npos, "Vulkan sampler slot incorrect");
+        const auto dxil = fmt::format("uint {}_Texture2DDescriptorIndex : packoffset(c{}.{});", name, index / 4, "xyzw"[index % 4]);
+        require(recompiler.out.find(dxil) != std::string::npos, "DXIL sampler slot incorrect");
+    }
+    TextureFetchInstruction fetch{};
+    fetch.opcode = FetchOpcode::TextureFetch;
+    fetch.dimension = TextureDimension::Texture2D;
+    fetch.constIndex = first + count - 1;
+    fetch.dstSwizzle = swizzle(0, 1, 2, 3);
+    recompiler.out.clear();
+    recompiler.recompile(fetch, false);
+    const auto name = count > 1 ? fmt::format("Array_{}", count - 1) : "Array";
+    require(recompiler.out.find(fmt::format("tfetch2D({0}_Texture2DDescriptorIndex, {0}_SamplerDescriptorIndex", name)) != std::string::npos,
+        "Last array element did not use its reflected sampler slot");
+}
+
+int main()
+{
+    checkFetches();
+    checkSamplers(1);
+    checkSamplers(3);
+    checkSamplers(1, 15);
+    for (auto [count, first] : {std::pair<uint16_t, uint16_t>{2, 15}, {1, 16}, {0, 3}})
+    {
+        bool rejected = false;
+        try { checkSamplers(count, first); }
+        catch (const std::runtime_error& error)
+        {
+            rejected = std::string(error.what()).find("supports only 16 slots") != std::string::npos;
+        }
+        require(rejected, "Unsupported sampler range was not explicitly rejected");
+    }
+    puts("PASS: sampler arrays and bounds, masked fetches, constant writes, predication");
+}
