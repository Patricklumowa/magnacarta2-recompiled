+void D3D12CommandProcessor::BeginGpuTimingFrame() {
+  if (!REXCVAR_GET(d3d12_gpu_profile_frame) || gpu_timing_pending_) return;
+  REXCVAR_SET(d3d12_gpu_profile_frame, false);
+  auto& provider = GetD3D12Provider();
+  if (FAILED(provider.GetDirectQueue()->GetTimestampFrequency(&gpu_timing_frequency_)) ||
+      !gpu_timing_frequency_) {
+    REXGPU_ERROR("GPU timing: timestamp frequency unavailable");
+    return;
+  }
+  if (!gpu_timing_heap_) {
+    D3D12_QUERY_HEAP_DESC desc = {D3D12_QUERY_HEAP_TYPE_TIMESTAMP, kMaxGpuTimingQueries, 0};
+    if (FAILED(provider.GetDevice()->CreateQueryHeap(&desc, IID_PPV_ARGS(&gpu_timing_heap_)))) {
+      REXGPU_ERROR("GPU timing: query heap allocation failed");
+      return;
+    }
+  }
+  if (!gpu_timing_readback_) {
+    D3D12_RESOURCE_DESC desc;
+    ui::d3d12::util::FillBufferResourceDesc(desc, sizeof(uint64_t) * kMaxGpuTimingQueries,
+                                         D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(provider.GetDevice()->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+            &desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&gpu_timing_readback_)))) {
+      REXGPU_ERROR("GPU timing: readback allocation failed");
+      return;
+    }
+  }
+  gpu_timing_draws_.clear();
+  gpu_timing_query_count_ = 1;
+  gpu_timing_active_ = true;
+  deferred_command_list_.D3DEndQuery(gpu_timing_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0);
+}
+
+void D3D12CommandProcessor::BeginGpuTimingDraw(uint64_t vertex_hash, uint64_t pixel_hash,
+                                             uint32_t vertices) {
+  if (!gpu_timing_active_ || gpu_timing_query_count_ + 2 >= kMaxGpuTimingQueries) return;
+  gpu_timing_draws_.push_back({vertex_hash, pixel_hash, vertices, gpu_timing_query_count_,
+                             1u << uint32_t(register_file_->Get<reg::RB_SURFACE_INFO>().msaa_samples)});
+  deferred_command_list_.D3DEndQuery(gpu_timing_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                    gpu_timing_query_count_++);
+}
+
+void D3D12CommandProcessor::EndGpuTimingDraw() {
+  if (!gpu_timing_active_ || gpu_timing_draws_.empty() ||
+      gpu_timing_draws_.back().query + 1 != gpu_timing_query_count_) return;
+  deferred_command_list_.D3DEndQuery(gpu_timing_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                    gpu_timing_query_count_++);
+}
+
+void D3D12CommandProcessor::CollectGpuTimingFrame() {
+  if (!gpu_timing_pending_ || submission_completed_ < gpu_timing_pending_ ||
+      submission_completed_ == UINT64_MAX) return;
+  D3D12_RANGE range = {0, sizeof(uint64_t) * gpu_timing_query_count_};
+  void* data = nullptr;
+  if (FAILED(gpu_timing_readback_->Map(0, &range, &data))) {
+    REXGPU_ERROR("GPU timing: readback map failed");
+    gpu_timing_pending_ = 0;
+    return;
+  }
+  auto ticks = static_cast<const uint64_t*>(data);
+  double to_ms = 1000.0 / double(gpu_timing_frequency_);
+  double draw_ms = 0;
+  for (const auto& draw : gpu_timing_draws_) {
+    double ms = double(ticks[draw.query + 1] - ticks[draw.query]) * to_ms;
+    draw_ms += ms;
+    REXGPU_INFO("GPU timing draw: vs={:016X} ps={:016X} vertices={} ms={:.6f} samples={}",
+                draw.vertex_hash, draw.pixel_hash, draw.vertices, ms, draw.sample_count);
+  }
+  REXGPU_INFO("GPU timing frame: total_ms={:.6f} draw_ms={:.6f} draws={} queries={} submission={}",
+              double(ticks[gpu_timing_query_count_ - 1] - ticks[0]) * to_ms,
+              draw_ms, gpu_timing_draws_.size(), gpu_timing_query_count_, gpu_timing_pending_);
+  D3D12_RANGE no_writes = {0, 0};
+  gpu_timing_readback_->Unmap(0, &no_writes);
+  gpu_timing_pending_ = 0;
+}
