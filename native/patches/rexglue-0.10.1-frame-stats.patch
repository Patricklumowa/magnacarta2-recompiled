+void RecordGuestFrame() {
+  if (!REXCVAR_GET(guest_frame_stats)) return;
+  using Clock = std::chrono::steady_clock;
+  static std::mutex mutex;
+  static Clock::time_point start, previous;
+  static uint64_t intervals = 0;
+  static double worst_ms = 0;
+  std::lock_guard lock(mutex);
+  const auto now = Clock::now();
+  if (previous == Clock::time_point{}) {
+    start = previous = now;
+    return;
+  }
+  ++intervals;
+  worst_ms = std::max(worst_ms, std::chrono::duration<double, std::milli>(now - previous).count());
+  previous = now;
+  const double seconds = std::chrono::duration<double>(now - start).count();
+  if (seconds >= 2.0) {
+    REXKRNL_INFO("Guest frames: {:.2f} FPS, mean {:.2f} ms, worst {:.2f} ms ({} intervals)",
+                 intervals / seconds, 1000.0 * seconds / intervals, worst_ms, intervals);
+    start = now;
+    intervals = 0;
+    worst_ms = 0;
+  }
+}
